# ── Enquiry delivery ────────────────────────────────────────────────────────
# Formspree forwards submissions to whatever inbox the form was created
# under — no SMTP credentials needed. Only set this to override the endpoint
# hardcoded as a fallback in app/api/enquiry/route.js (e.g. if it's rotated).
FORMSPREE_ENDPOINT=https://formspree.io/f/mzebzqgr

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical origin, used for metadata, sitemap, robots and structured data.
# Set this to the live domain once it is pointed at the deployment.
NEXT_PUBLIC_SITE_URL=https://spacesbyraag.com

# ── Analytics & Search Console (PRD section 8) ──────────────────────────────
# GA4 measurement ID. Analytics stays off entirely until this is set.
NEXT_PUBLIC_GA_ID=
# Token from Google Search Console's HTML-tag verification method.
NEXT_PUBLIC_GSC_VERIFICATION=
